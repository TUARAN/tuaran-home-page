# App URL / session
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth Client
GOOGLE_ID=
GOOGLE_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 微信开放平台审核通过且 AppID / Secret 已配置后，同时设为 true 并重新部署。
WECHAT_LOGIN_ENABLED=false
NEXT_PUBLIC_WECHAT_LOGIN_ENABLED=false

# Owner allowlist, comma-separated. User ids are provider-prefixed, e.g. github:123456 or google:abc.
SITE_OWNER_IDS=
SITE_OWNER_LOGINS=
SITE_OWNER_EMAILS=

# Email login / registration codes
EMAIL_CODE_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare D1 binding name in Pages/Workers: DB
DB=

# Voice task API fallback token
VOICE_TASK_API_TOKEN=

# Optional distribution target used by research markdown export UI
NEXT_PUBLIC_SYNCBLOG_IMPORT_URL=

# Owner-only direct article distribution to X (OAuth 1.0a user context).
# Keep all four values server-side; never expose them with NEXT_PUBLIC_ prefixes.
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Morning greeting automation: GitHub Actions 定时调用 /api/distribution/x/greeting 的鉴权密钥。
# 必须在 GitHub 仓库 Secret 和 Cloudflare Pages 环境变量两处配置相同值。
MORNING_GREETING_SECRET=

# Google AdSense. Client example: ca-pub-0000000000000000
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=
NEXT_PUBLIC_GOOGLE_ADSENSE_ARTICLE_SLOT=
NEXT_PUBLIC_GOOGLE_ADSENSE_RESEARCH_SLOT=

# 调研加密：标记 encrypted: true 的调研在构建期用此密码做 AES-256-GCM 加密。
# 本地放到 .env.local；线上在 Cloudflare Pages 构建环境变量里设置同一个值。
RESEARCH_ENCRYPTION_PASSWORD=
