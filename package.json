{
  "name": "tuaran-blog",
  "version": "1.0.0",
  "description": "TUARAN's personal blog homepage with modern design",
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "prebuild": "node scripts/check-tailwind-opacity-classes.mjs && node scripts/check-public-asset-size.mjs && node scripts/audit-research-style.mjs && node scripts/generate-research-catalog.mjs && node scripts/audit-adsense-readiness.mjs",
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:check": "NEXT_DIST_DIR=.next-check next build",
    "security:check": "node scripts/check-sensitive-files.mjs",
    "start": "next start -p 3000",
    "desktop:dev": "ELECTRON_START_URL=http://127.0.0.1:3000 electron desktop/main.cjs",
    "desktop:build": "electron-builder --projectDir desktop --config ../electron-builder.desktop.json --mac dmg --x64 --arm64 --win nsis --x64 --publish=never && node scripts/verify-desktop-installers.mjs",
    "desktop:build:mac": "electron-builder --projectDir desktop --config ../electron-builder.desktop.json --mac dmg --x64 --arm64 --publish=never && node scripts/verify-desktop-installers.mjs",
    "desktop:build:win": "electron-builder --projectDir desktop --config ../electron-builder.desktop.json --win nsis --x64 --publish=never && node scripts/verify-desktop-installers.mjs",
    "gallery:sync": "node scripts/generate-nano-banana-gallery.mjs",
    "library:sync": "node scripts/generate-ai-learning-library.mjs",
    "pages:build": "npm run pages:build:admin",
    "pages:build:all": "npx @cloudflare/next-on-pages@1.13.16 && node scripts/patch-pages-routes.cjs",
    "pages:build:admin": "node scripts/build-admin-pages.cjs && node scripts/verify-admin-pages-build.cjs && node scripts/patch-pages-routes.cjs",
    "pages:build:public": "node scripts/build-public-pages.cjs",
    "lint": "node scripts/check-tailwind-opacity-classes.mjs && next lint",
    "style:check": "node scripts/check-tailwind-opacity-classes.mjs",
    "research:style-audit": "node scripts/audit-research-style.mjs",
    "taxonomy:audit": "node scripts/generate-research-catalog.mjs && node --test tests/navigation/content-taxonomy.test.mjs",
    "a-share:sync": "node scripts/manage-a-share-research.mjs sync",
    "a-share:pick": "node scripts/manage-a-share-research.mjs pick",
    "a-share:complete": "node scripts/manage-a-share-research.mjs complete",
    "a-share:status": "node scripts/manage-a-share-research.mjs status",
    "a-share:test": "node --test scripts/test-a-share-research.mjs",
    "adsense:audit": "node scripts/audit-adsense-readiness.mjs",
    "adsense:deployment": "node scripts/audit-adsense-deployment.mjs",
    "adsense:links": "node scripts/audit-adsense-link-graph.mjs",
    "adsense:live": "node scripts/audit-adsense-deployment.mjs https://2aran.com && node scripts/audit-adsense-link-graph.mjs https://2aran.com && node scripts/audit-adsense-rendered-content.mjs https://2aran.com",
    "adsense:rendered": "node scripts/audit-adsense-rendered-content.mjs",
    "snapshot-memory": "node scripts/snapshot-memory.mjs",
    "mcp:stdio": "node tools/mcp-stdio-demo/server.mjs",
    "mcp:stdio:check": "node scripts/test-mcp-stdio-demo.mjs",
    "x-intelligence:check": "node scripts/test-x-platform-intelligence-model.mjs && node scripts/test-x-platform-intelligence-filters.mjs && node scripts/test-x-platform-intelligence-selectors.mjs",
    "test:planning": "node --test tests/planning/*.test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/typography": "^0.5.10",
    "@tiptap/extension-character-count": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "echarts": "^6.1.0",
    "fast-xml-parser": "^5.9.3",
    "marked": "^14.1.4",
    "next": "^15.5.20",
    "next-themes": "^0.4.6",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "autoprefixer": "^10.4.21",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "8.5.16",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "postcss": "8.5.16",
    "glob": "10.5.0",
    "minimatch": "9.0.9",
    "brace-expansion": "2.1.1",
    "picomatch": "2.3.2",
    "protobufjs": "7.6.5",
    "yaml": "2.9.0"
  }
}
