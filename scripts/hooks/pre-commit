#!/usr/bin/env bash
# Main workspace commits are allowed under AGENTS.md.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Satellite worktree: node_modules must symlink to main, not a full npm install copy.
if [ -n "$ALLOW_LOCAL_NODE_MODULES" ]; then
  exit 0
fi

if [ -f "$REPO_ROOT/.git" ] && [ -e "$REPO_ROOT/node_modules" ] && [ ! -L "$REPO_ROOT/node_modules" ]; then
  echo "[pre-commit] FAIL: satellite worktree has a real node_modules directory." >&2
  echo "Only the main worktree should run npm install. Replace with a symlink:" >&2
  echo "  npm run worktree:link-deps" >&2
  echo "If you must keep a local copy: ALLOW_LOCAL_NODE_MODULES=1 git commit ..." >&2
  exit 1
fi

exit 0
