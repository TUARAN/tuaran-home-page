#!/usr/bin/env bash
# Pre-commit: reject commits made in the main workspace; all work must start in a separate worktree.
# Detection is by directory shape, not branch name: a main workspace has .git as a directory,
# a linked worktree has .git as a file. Checking out a new branch in the main workspace is NOT
# isolation - it is the same directory with other agents' uncommitted changes still mixed in.
#
# Bypass: ALLOW_MAIN_COMMIT=1 git commit ...   (owner explicitly wants a direct commit)
# Disable: git config --unset core.hooksPath
# Scope: only this machine's clone (core.hooksPath=scripts/hooks); cloud VMs are not covered.

set -e

if [ -n "$ALLOW_MAIN_COMMIT" ]; then
  echo "[pre-commit] ALLOW_MAIN_COMMIT set, allowing commit in the main workspace."
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
if [ -d "$REPO_ROOT/.git" ]; then
  BRANCH="$(git branch --show-current 2>/dev/null || true)"
  [ -n "$BRANCH" ] || BRANCH='detached HEAD'
  echo "[pre-commit] FAIL: commit in the main workspace is blocked (branch: $BRANCH)." >&2
  echo >&2
  echo "Creating a new branch in the main workspace is not isolation: same directory," >&2
  echo "other agents' uncommitted changes stay mixed in. This repo deploys on merge," >&2
  echo "so PR is the only merge path. Start a separate worktree first:" >&2
  echo "  git worktree add -b codex/<task> <path> origin/main" >&2
  echo "Commit, push and open a PR there; remove the worktree the day it merges." >&2
  echo >&2
  echo "Owner override: ALLOW_MAIN_COMMIT=1 git commit ..." >&2
  exit 1
fi

exit 0
