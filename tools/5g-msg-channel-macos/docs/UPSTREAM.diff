+let buf='';socket.on('connect',()=>socket.write(JSON.stringify({jsonrpc:'2.0',id:1,method:'tools/call',params:{name:command==='status'?'bridge_status':'send_5g',arguments:command==='send'?{to:value('--to'),text:value('--text')}:{}}})+'\n'));
