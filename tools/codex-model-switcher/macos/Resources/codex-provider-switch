#!/bin/sh
set -eu

mode="${1:-}"
codex_dir="${CODEX_HOME:-$HOME/.codex}"
config_path="$codex_dir/config.toml"
marker_path="$codex_dir/provider-mode"
agents_path="$codex_dir/agents/v4-flash-worker.toml"
hooks_path="$codex_dir/hooks.json"
codex_bin="/Applications/ChatGPT.app/Contents/Resources/codex"

case "$mode" in gpt|deepseek|hybrid) ;; *) echo "Usage: $0 gpt|deepseek|hybrid" >&2; exit 2 ;; esac
[ -f "$config_path" ] || { echo "Codex config not found: $config_path" >&2; exit 1; }

if [ "$mode" = deepseek ] || [ "$mode" = hybrid ]; then
  [ -n "$(/bin/launchctl getenv DEEPSEEK_API_KEY 2>/dev/null || true)" ] || {
    echo "DeepSeek API Key 未设置。请先在应用的“DeepSeek 设置”中保存。" >&2
    exit 1
  }
fi

if [ "$mode" = hybrid ]; then
  [ -f "$agents_path" ] || { echo "DeepSeek Subagent 未安装：缺少 $agents_path" >&2; exit 1; }
  [ -f "$hooks_path" ] || { echo "DeepSeek Subagent Hook 未安装：缺少 $hooks_path" >&2; exit 1; }
fi

backup_path="$config_path.before-provider-switch"
temp_path=$(mktemp "$config_path.switch.XXXXXX")
trap 'rm -f "$temp_path"' EXIT HUP INT TERM
cp "$config_path" "$backup_path"

awk -v mode="$mode" '
function emit_settings() {
  if (mode == "deepseek") {
    print "model = \"deepseek-chat\""
    print "model_provider = \"deepseek\""
    print "model_reasoning_effort = \"high\""
  } else {
    print "model = \"gpt-5.6-sol\""
    print "model_provider = \"openai\""
    print "model_reasoning_effort = \"medium\""
    print "service_tier = \"priority\""
  }
  print ""
}
BEGIN {
  emit_settings(); in_table=0; skip_deepseek=0
  target["model"]=1; target["model_provider"]=1; target["model_reasoning_effort"]=1
  target["service_tier"]=1; target["model_catalog_json"]=1
  target["preferred_auth_method"]=1; target["forced_login_method"]=1
}
{
  if ($0 ~ /^\[model_providers\.deepseek(\.|\])/) { skip_deepseek=1; next }
  if (skip_deepseek && $0 ~ /^\[/) skip_deepseek=0
  if (skip_deepseek) next
  if (!in_table && $0 ~ /^[[:space:]]*\[/) in_table=1
  if (!in_table && $0 ~ /^[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*=/) {
    key=$0; sub(/=.*/, "", key); gsub(/[[:space:]]/, "", key); if (target[key]) next
  }
  print
}
END {
  print ""
  print "[model_providers.deepseek]"
  print "name = \"DeepSeek\""
  print "base_url = \"https://api.deepseek.com\""
  print "wire_api = \"responses\""
  print "env_key = \"DEEPSEEK_API_KEY\""
  print "env_key_instructions = \"Set the key in Codex Model Switcher. Never store it in this file.\""
}
' "$config_path" > "$temp_path"

chmod 600 "$temp_path"
mv "$temp_path" "$config_path"
trap - EXIT HUP INT TERM

if [ "${CODEX_SWITCHER_SKIP_VALIDATION:-0}" != 1 ]; then
  if [ -x "$codex_bin" ]; then "$codex_bin" features list >/dev/null
  else codex features list >/dev/null
  fi
fi
printf '%s\n' "$mode" > "$marker_path"
echo "Switched Codex provider mode to $mode. Fully quit and reopen Codex to apply."
