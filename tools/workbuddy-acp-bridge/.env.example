# WorkBuddy 开放平台“硬件接入”应用凭据。不要提交真实值。
WORKBUDDY_CLIENT_ID=app_xxx
WORKBUDDY_CLIENT_SECRET=开放平台创建时只展示一次的密钥
# OAuth 回调必须和开放平台已登记的地址逐字一致。
# 本机收授权码用线上已登记的本地 5G 回调，不要再用 8799。
WORKBUDDY_REDIRECT_URI=http://localhost:8080/workbuddy/api
# 可选：仅当应用已获 user.contact.readable 时，用于本机 phoneverification 烟测。
# 保留在未提交的 .env；报告不会保存号码。
WORKBUDDY_TEST_PHONE=

# 设备请求需携带 X-Bridge-Key。请替换为随机长字符串。
WORKBUDDY_BRIDGE_KEY=replace-with-at-least-24-random-characters
WORKBUDDY_BRIDGE_MODE=mock
WORKBUDDY_BRIDGE_HOST=127.0.0.1
WORKBUDDY_BRIDGE_PORT=8080
WORKBUDDY_TOKEN_FILE=./var/workbuddy-token.json
