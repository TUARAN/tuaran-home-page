{
  "name": "@tuaran/workbuddy-acp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "短信式硬件模拟器与 WorkBuddy ACP 本地桥接桌面应用",
  "main": "desktop/main.cjs",
  "author": "TUARAN",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.mjs start",
    "doctor": "node --env-file-if-exists=.env src/cli.mjs doctor",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron desktop/main.cjs",
    "build:mac": "electron-builder --mac dmg zip --publish=never",
    "build:win": "electron-builder --win nsis --x64 --publish=never"
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "26.0.12"
  },
  "engines": { "node": ">=22.12.0 <23" },
  "build": {
    "appId": "com.tuaran.workbuddy-acp-bridge",
    "productName": "ACP 短信桥接台",
    "electronVersion": "43.0.0",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "desktop/assets/icon.png",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
