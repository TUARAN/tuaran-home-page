{
  "manifest_version": 3,
  "name": "2aran X Article Auto Publisher",
  "version": "0.3.0",
  "description": "Prepare, verify, and automatically publish one 2aran article to X Articles every day, including images, tables, and Mermaid diagrams.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://2aran.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X Article 自动发布",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://2aran.com/articles/*"],
      "js": ["format-core.js", "site-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["format-core.js", "main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["format-core.js", "x-content.js"],
      "run_at": "document_idle"
    }
  ]
}
