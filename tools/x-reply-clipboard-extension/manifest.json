{
  "manifest_version": 3,
  "name": "X Interaction Assistant",
  "version": "3.1.4",
  "description": "Manage mutual follows, reply on X timelines, or like and reply from Notifications. Supports templates and DeepSeek AI.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.deepseek.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["draftFill.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["phrases.js", "loop.js", "mutual.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
