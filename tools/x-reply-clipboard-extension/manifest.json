{
  "manifest_version": 3,
  "name": "X Interaction Assistant",
  "version": "3.32.20",
  "description": "Run home and notification interactions, optional likes, follow management, and scheduled posts in dedicated X tabs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "X Interaction Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "offscreen", "alarms"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.deepseek.com/*", "https://api.b.ai/*", "https://2aran.com/*", "https://aihot.news/*", "https://www.toutiao.com/*", "https://www.zhihu.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["draftFill.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["context.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["receipt.js", "phrases.js", "loop.js", "timer.js", "poster.js", "mutual.js", "tweetPdf.js", "autoLike.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
