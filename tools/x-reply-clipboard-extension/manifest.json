{
  "manifest_version": 3,
  "name": "X Timeline Reply Assistant",
  "version": "2.0.0",
  "description": "Reply on the X timeline with a random saved phrase or a DeepSeek-generated response. Refresh after every 35 successful replies.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.deepseek.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["draftFill.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["phrases.js", "loop.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
