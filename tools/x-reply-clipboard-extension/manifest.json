{
  "manifest_version": 3,
  "name": "X Interaction Assistant",
  "version": "3.2.0",
  "description": "Reply on timelines and notifications, manage mutual follows, and publish DeepSeek-generated text posts on a schedule.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.deepseek.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["draftFill.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["phrases.js", "loop.js", "timer.js", "poster.js", "mutual.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
