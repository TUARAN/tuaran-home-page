{
  "manifest_version": 3,
  "name": "X Timeline Reply Assistant",
  "version": "0.2.8",
  "description": "Open each post's reply popup, insert a random saved phrase, and send Reply. Refresh after 35 replies and continue from the top.",
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["draftFill.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["phrases.js", "loop.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
