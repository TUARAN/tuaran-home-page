{
  "manifest_version": 3,
  "name": "X Reply Clipboard",
  "version": "0.1.0",
  "description": "Open each post's reply popup, paste the clipboard, and send Reply. Refresh after 35 replies and continue from the top.",
  "permissions": ["clipboardRead"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["loop.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
