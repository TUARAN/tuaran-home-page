{
  "manifest_version": 3,
  "name": "X Tweet to PDF",
  "version": "0.1.0",
  "description": "Turn the X/Twitter post you are viewing into a clean, printable PDF.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "action": {
    "default_title": "X Tweet to PDF",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
